@Article{Liu2024,
author={Liu, Yihao
and Chen, Junyu
and Wei, Shuwen
and Carass, Aaron
and Prince, Jerry},
title={On Finite Difference Jacobian Computation in Deformable Image  Registration},
journal={International Journal of Computer Vision},
year={2024},
month={Sep},
day={01},
volume={132},
number={9},
pages={3678-3688},
abstract={Producing spatial transformations that are diffeomorphic is a key goal in deformable image registration. As a diffeomorphic transformation should have positive Jacobian determinant {\$}{\$}{\backslash}vert J{\backslash}vert {\$}{\$}everywhere, the number of pixels (2D) or voxels (3D) with {\$}{\$}{\backslash}vert J{\backslash}vert <0{\$}{\$}has been used to test for diffeomorphism and also to measure the irregularity of the transformation. For digital transformations, {\$}{\$}{\backslash}vert J{\backslash}vert {\$}{\$}is commonly approximated using a central difference, but this strategy can yield positive {\$}{\$}{\backslash}vert J{\backslash}vert {\$}{\$}'s for transformations that are clearly not diffeomorphic---even at the pixel or voxel resolution level. To show this, we first investigate the geometric meaning of different finite difference approximations of {\$}{\$}{\backslash}vert J{\backslash}vert {\$}{\$}. We show that to determine if a deformation is diffeomorphic for digital images, the use of any individual finite difference approximation of {\$}{\$}{\backslash}vert J{\backslash}vert {\$}{\$}is insufficient. We further demonstrate that for a 2D transformation, four unique finite difference approximations of {\$}{\$}{\backslash}vert J{\backslash}vert {\$}{\$}'s must be positive to ensure that the entire domain is invertible and free of folding at the pixel level. For a 3D transformation, ten unique finite differences approximations of {\$}{\$}{\backslash}vert J{\backslash}vert {\$}{\$}'s are required to be positive. Our proposed digital diffeomorphism criteria solves several errors inherent in the central difference approximation of {\$}{\$}{\backslash}vert J{\backslash}vert {\$}{\$}and accurately detects non-diffeomorphic digital transformations. The source code of this work is available at https://github.com/yihao6/digital{\_}diffeomorphism.},
issn={1573-1405},
doi={10.1007/s11263-024-02047-1},
url={https://doi.org/10.1007/s11263-024-02047-1}
}


