\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Test pair (patient 0054, follow-up 01 $\rightarrow $ baseline 00), chosen as the pair with at least 5 lesions whose CT Dice for Ours + IO is closest to the median. Ours (full): with the PET and rigidity losses in training and IO. Top: CT, coronal slice through the spine, with the fixed scan's organ-label boundaries (yellow). Middle: PET maximum-intensity projection (SUV 0--8) with the warped lesion mask (red); left: fixed scan and its lesions. Bottom: Jacobian determinant on the same slice (folds in black). Initial: the moving scan, not resampled.}}{22}{figure.5}\protected@file@percent }
\newlabel{fig:qualitative}{{5}{22}{Test pair (patient 0054, follow-up 01 $\rightarrow $ baseline 00), chosen as the pair with at least 5 lesions whose CT Dice for Ours + IO is closest to the median. Ours (full): with the PET and rigidity losses in training and IO. Top: CT, coronal slice through the spine, with the fixed scan's organ-label boundaries (yellow). Middle: PET maximum-intensity projection (SUV 0--8) with the warped lesion mask (red); left: fixed scan and its lesions. Bottom: Jacobian determinant on the same slice (folds in black). Initial: the moving scan, not resampled}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Effect of the PET loss weight in IO (test set): network trained without PET losses (T1) followed by IO with all PET weights scaled by the given factor (0: PET losses off; 1: the PET weights of network training). Each metric on the predicted labels that IO optimises (orange; organs: TotalSegmentator, lesions: nnU-Net) and on the ground-truth labels used for evaluation (blue). Dice over all 28 patients, lesion volume and uptake change over the 26 patients with lesions in both label sets. Solid: after IO; dashed: network output before IO, the same for every factor. Outlined point and dotted line: operating point tuned on the validation set. Points: patient means; bands: 95\,\% patient-bootstrap confidence intervals.}}{23}{figure.6}\protected@file@percent }
\newlabel{fig:tradeoff}{{6}{23}{Effect of the PET loss weight in IO (test set): network trained without PET losses (T1) followed by IO with all PET weights scaled by the given factor (0: PET losses off; 1: the PET weights of network training). Each metric on the predicted labels that IO optimises (orange; organs: TotalSegmentator, lesions: nnU-Net) and on the ground-truth labels used for evaluation (blue). Dice over all 28 patients, lesion volume and uptake change over the 26 patients with lesions in both label sets. Solid: after IO; dashed: network output before IO, the same for every factor. Outlined point and dotted line: operating point tuned on the validation set. Points: patient means; bands: 95\,\% patient-bootstrap confidence intervals}{figure.6}{}}
