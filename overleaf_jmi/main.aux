\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Test pair with a large change in tumour volume (patient 0146; lesion volume 2400 voxels at baseline, 24191 at follow-up), registered by our full method (PET and rigidity losses in training and IO); one coronal slice. (a)\nobreakspace  {}Fixed and (b)\nobreakspace  {}moving CT with PET (SUV 0--8, 35\,\% opacity) and ground-truth lesion contours (red). (c,\nobreakspace  {}d)\nobreakspace  {}CT of the fixed scan (green) overlaid with the moving scan (magenta) before\nobreakspace  {}(c) and after\nobreakspace  {}(d) registration; grey where they agree. (e,\nobreakspace  {}f)\nobreakspace  {}Organ labels that differ before\nobreakspace  {}(e) and after\nobreakspace  {}(f) registration: green where the fixed scan has a label that the moving scan lacks there, magenta where only the moving scan is labelled; bright, medium, and dark shades for bones, organs, and muscles. (g)\nobreakspace  {}Jacobian determinant of the transformation. (h)\nobreakspace  {}Warped moving CT with PET and warped lesion contours.}}{23}{figure.5}\protected@file@percent }
\newlabel{fig:qualitative}{{5}{23}{Test pair with a large change in tumour volume (patient 0146; lesion volume 2400 voxels at baseline, 24191 at follow-up), registered by our full method (PET and rigidity losses in training and IO); one coronal slice. (a)~Fixed and (b)~moving CT with PET (SUV 0--8, 35\,\% opacity) and ground-truth lesion contours (red). (c,~d)~CT of the fixed scan (green) overlaid with the moving scan (magenta) before~(c) and after~(d) registration; grey where they agree. (e,~f)~Organ labels that differ before~(e) and after~(f) registration: green where the fixed scan has a label that the moving scan lacks there, magenta where only the moving scan is labelled; bright, medium, and dark shades for bones, organs, and muscles. (g)~Jacobian determinant of the transformation. (h)~Warped moving CT with PET and warped lesion contours}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Rigidity weight sweep on the validation set: network trained with the PET losses, IO with the PET terms and one rigidity penalty at $0.1$ to $100$ times its calibrated reference weight (factors at the ends of each line). Top: CT Dice, bottom: bone Dice; left: distortion of short (5--15\nobreakspace  {}mm), right: of long ($\geq $15\nobreakspace  {}mm) within-bone distances, i.e.\ the mean relative change of the distance between point pairs in the same bone. Star: variant without rigidity; dashed (a,\nobreakspace  {}b): selection threshold, one Dice point below it; outlined: weight chosen for the test set (the largest within the threshold, at most $\times 100$). Points: patient means.}}{24}{figure.6}\protected@file@percent }
\newlabel{fig:rigidity}{{6}{24}{Rigidity weight sweep on the validation set: network trained with the PET losses, IO with the PET terms and one rigidity penalty at $0.1$ to $100$ times its calibrated reference weight (factors at the ends of each line). Top: CT Dice, bottom: bone Dice; left: distortion of short (5--15~mm), right: of long ($\geq $15~mm) within-bone distances, i.e.\ the mean relative change of the distance between point pairs in the same bone. Star: variant without rigidity; dashed (a,~b): selection threshold, one Dice point below it; outlined: weight chosen for the test set (the largest within the threshold, at most $\times 100$). Points: patient means}{figure.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.7}Accuracy--Preservation Trade-off}{24}{subsection.4.7}\protected@file@percent }
\newlabel{sect:res_tradeoff}{{4.7}{24}{Accuracy--Preservation Trade-off}{subsection.4.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Rigidity penalties compared (validation set, draft, 26 patients): network trained with the PET losses, IO with the PET terms and one rigidity penalty at the weight chosen on the validation set. Rigidity of bones is measured in three ways: the residual of a rigid fit to each bone (the quantity the rigid-fit penalty minimises), the Staring energy, i.e.\ the Staring penalty (properness, orthonormality, and affinity) on the whole bone (the quantity the Staring penalty minimises), and the distortion of short (5--15\nobreakspace  {}mm) and long ($\geq $15\nobreakspace  {}mm) within-bone distances (minimised by neither). Mean$\pm $SD over patients. $^{\dagger }$/$^{\ddagger }$: significantly better/worse than without rigidity (two-sided Wilcoxon signed-rank test on patient values, Holm-corrected over the three penalties per column, $p<0.05$).}}{25}{table.5}\protected@file@percent }
\newlabel{tab:rigidity}{{5}{25}{Rigidity penalties compared (validation set, draft, 26 patients): network trained with the PET losses, IO with the PET terms and one rigidity penalty at the weight chosen on the validation set. Rigidity of bones is measured in three ways: the residual of a rigid fit to each bone (the quantity the rigid-fit penalty minimises), the Staring energy, i.e.\ the Staring penalty (properness, orthonormality, and affinity) on the whole bone (the quantity the Staring penalty minimises), and the distortion of short (5--15~mm) and long ($\geq $15~mm) within-bone distances (minimised by neither). Mean$\pm $SD over patients. $^{\dagger }$/$^{\ddagger }$: significantly better/worse than without rigidity (two-sided Wilcoxon signed-rank test on patient values, Holm-corrected over the three penalties per column, $p<0.05$)}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Effect of the rigidity weight on lesion preservation (validation set): network trained with the PET losses, IO with the PET terms and one rigidity penalty at $0.1$ to $100$ times its calibrated reference weight. (a)\nobreakspace  {}Lesion volume change, (b)\nobreakspace  {}uptake change. Dashed: IO without rigidity; outlined: weight chosen for the test set. Points: patient means.}}{25}{figure.7}\protected@file@percent }
\newlabel{fig:rigidity_preservation}{{7}{25}{Effect of the rigidity weight on lesion preservation (validation set): network trained with the PET losses, IO with the PET terms and one rigidity penalty at $0.1$ to $100$ times its calibrated reference weight. (a)~Lesion volume change, (b)~uptake change. Dashed: IO without rigidity; outlined: weight chosen for the test set. Points: patient means}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Effect of the PET loss weight in IO (test set): network trained without PET losses (T1) followed by IO with all PET weights scaled by the given factor (0: PET losses off; 1: the PET weights of network training). Each metric on the predicted labels that IO optimises (orange; organs: TotalSegmentator, lesions: nnU-Net) and on the ground-truth labels used for evaluation (blue). Dice over all 28 patients, lesion volume and uptake change over the 26 patients with lesions in both label sets. Solid: after IO; dashed: network output before IO, the same for every factor. Outlined point and dotted line: operating point tuned on the validation set. Black diamonds: IO with the ground-truth instead of the predicted lesion masks (at $\times 0.1$ and $\times 1$), evaluated on the ground-truth labels. Points: patient means; bands: 95\,\% patient-bootstrap confidence intervals.}}{26}{figure.8}\protected@file@percent }
\newlabel{fig:tradeoff}{{8}{26}{Effect of the PET loss weight in IO (test set): network trained without PET losses (T1) followed by IO with all PET weights scaled by the given factor (0: PET losses off; 1: the PET weights of network training). Each metric on the predicted labels that IO optimises (orange; organs: TotalSegmentator, lesions: nnU-Net) and on the ground-truth labels used for evaluation (blue). Dice over all 28 patients, lesion volume and uptake change over the 26 patients with lesions in both label sets. Solid: after IO; dashed: network output before IO, the same for every factor. Outlined point and dotted line: operating point tuned on the validation set. Black diamonds: IO with the ground-truth instead of the predicted lesion masks (at $\times 0.1$ and $\times 1$), evaluated on the ground-truth labels. Points: patient means; bands: 95\,\% patient-bootstrap confidence intervals}{figure.8}{}}
